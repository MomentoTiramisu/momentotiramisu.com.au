<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="shortcut icon" type="image/png" href="https://res.cloudinary.com/dka765zib/image/upload/v1768458154/M_r14ldo.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"/>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
</head>
<body data-page="register">
    <section class="section-nav">
        <div class="logo">
            <a href="/"><img src="https://res.cloudinary.com/dka765zib/image/upload/v1770177748/Mchoc_jjjfbr.png"></a>
        </div>
        <a class="user-login icon"><i class="far fa-user"></i></a>
        <a href="/cart" class="cart icon"><i class="fas fa-cart-shopping"></i>
            <span class="cart-badge">0</span>
        </a>
    </section>
    <div class="navbar">
        <div class="hamburger-menu">
            <div class="line line-1"></div>
            <div class="line line-2"></div>
            <div class="line line-3"></div>
        </div>
        <nav class="nav-list-side">
            <div class="menu">
                <a href="/" class="navbar-link">Home</a>
                <a href="/#products" class="navbar-link">Products</a>
                <a href="/#about" class="navbar-link">About us</a>
                <a href="/online-orders" class="navbar-link">Online orders</a>
            </div>
            <div class="social-media">
                <a href="mailto:michele93saldana@gmail.com"> <i class="far fa-envelope"></i></a>
                <a href="https://www.instagram.com/momento_tiramisu2025/" target="_blank" rel="noopener noreferrer"><i class="fab fa-instagram"></i></a>
            </div>
        </nav>
    </div>

    <main>        
        <div class="container">
            <div class="row">
                <div class="swiperlogin mySwiperLogin">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <img src="https://res.cloudinary.com/dka765zib/image/upload/v1775978843/1W2A6527_websize_ptrsxh.jpg" alt="">
                        </div>
                        <div class="swiper-slide">
                            <img src="https://res.cloudinary.com/dka765zib/image/upload/v1775978844/1W2A3472_websize_aa3g7x.jpg" alt="">
                        </div>
                        <div class="swiper-slide">
                            <img src="https://res.cloudinary.com/dka765zib/image/upload/v1775978844/1W2A2883_websize_y2yl8g.jpg" alt="">
                        </div>
                    </div>
                    <div class="swiper-pagination"></div>
                </div>

                <div class="register-block" id="register" aria-labelledby="register-tab">
                    <h1 class="text-create-account">Create Your Account!</h1>
                    <form class="register-form">
                        <div class="email-reg">
                            <label for="register-email">Email adress</label>
                            <input class="form-control"  type="email" id="register-email" required placeholder="Enter email" />
                        </div>
                
                        <div class="passw-reg">
                            <label for="register-password">Password</label>
                            <div class="input-container">
                                <input class="form-control" type="password" id="register-password" required placeholder="Password" />
                                <i class="fa-solid fa-eye toggle-password"></i>
                            </div>
                        </div>
                
                        <div class="re-passw-reg">
                            <label for="register-re-enter-Password">Re-enter password</label>
                            <div class="input-container">
                                <input type="password" id="register-re-enter-Password" required class="form-control" placeholder="Re enter password" />
                                <i class="fa-solid fa-eye toggle-password"></i>
                            </div>
                        </div>
                
                        <div class="text-password-must">
                            <h3>Password must contains :</h3>
                            <ul>
                                <li><i class="fa-solid fa-x"></i>minimum of 12 characters</li>
                                <li><i class="fa-solid fa-x"></i>mix of uppercase letters, lowercase letters and numbers</li>
                                <li><i class="fa-solid fa-x"></i>mix of these special characters: (!@$)#&*()-_+{};:",./?</li>
                            </ul>
                        </div>
                              
                        <div class="check check-style">
                            <input type="checkbox" id="terms" name="terms" required>
                            <label for="terms">
                                I acknowledge that I have read and agree to the 
                                <a href="/Momento-Terms-and-conditions.pdf" target="_blank">Terms and Conditions</a> and
                                <a href="/Momento-Privacy-policy.pdf" target="_blank">Privacy Policy</a>.
                            </label>
                        </div>
                        
                        <button class="form-btn">Create Account</button>
                       
                        <h3 class="account-text">Already have an Account? <a id="login-url" href="/login">Login</a></h3>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@12/modules/effects/gl/swiper-gl.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script src="script.js"></script>
</body>
</html>