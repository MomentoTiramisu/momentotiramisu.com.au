<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <link rel="shortcut icon" type="image/png" href="https://res.cloudinary.com/xd8f5rcj/image/upload/v1788163085/M_r14ldo.png">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
</head>
<body data-page="reset-password">
    <main>
        <div class="reset-container">
            <div class="reset-logo">
                <a><img src="https://res.cloudinary.com/xd8f5rcj/image/upload/v1788161773/EVcoUYbg_oebgoh.png"></a>
            </div>
            <div class="reset-block">
                <h1 class="text-center">Reset your password</h1>
                <form class="reset-password-form">
                    <div class="reset-passw-sign">
                        <label for="reset-new-password">New password</label>
                        <div class="input-container">
                            <input class="form-control" type="password" id="reset-new-password" required placeholder="New password" />
                            <i class="fa-solid fa-eye toggle-password reset-icon"></i>
                        </div>
                    </div>
                    <div class="reset-passw-sign">
                        <label for="reset-confirm-password">Confirm password</label>
                        <div class="input-container">
                            <input class="form-control" type="password" id="reset-confirm-password" required placeholder="Confirm password" />
                            <i class="fa-solid fa-eye toggle-password"></i>
                        </div>
                    </div>
                    <div class="text-password-must">
                        <h3>Password must contains :</h3>
                        <ul>
                            <li><i class="fa-solid fa-x"></i>minimum of 12 characters</li>
                            <li><i class="fa-solid fa-x"></i>mix of uppercase letters, lowercase letters and numbers</li>
                            <li><i class="fa-solid fa-x"></i>mix of these special characters: (!@$)#&*()-_+{};:",./?</li>
                        </ul>
                    </div>
                    <button class="form-btn">Update password</button>

                    <input type="hidden" id="resetToken" value="<%= token %>">
                </form>
            </div>
        </div>
    </main>

   

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script src="/script.js"></script>
</body>
</html>